# Output the tool produces. None of this belongs in the repository, and some of it
# can contain cluster detail you did not mean to publish.
acs_audit_*/
acs_findings_*/
acs_via_oc_*/
acs_ssh_*/
findings/
*.ndjson
acs_alerts*.json
acs_findings*.json
acs_findings*.sarif
acs_vulns*.json
workloads*.json
*_image_worklist.md
FIXING_VIOLATIONS.md
CHANGES.md
PROPOSED_CHANGES.md

# Credentials and certificates. Belt and braces: the tool never writes these, but a
# person following the README by hand might.
*.pem
*.key
*.crt
.hdr
ca.pem
central-ca.pem
.env

# Generated documentation.
#
# These are built from docs/doc1.js and docs/doc2.js. Committing them meant a
# documentation change arrived as "Bin 1128727 -> 1129347 bytes", which nobody can
# review, and the repository carried both the source and the output of the same thing.
# They are built in CI and attached to each release instead.
#
#   node docs/doc1.js && node docs/doc2.js
docs/*.docx
docs/*.pdf

# Tooling
node_modules/
package-lock.json
__pycache__/
*.pyc

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Archives. Ship releases through GitHub Releases, not committed zips.
*.zip
*.tar.gz
dist/

# Probe files from tooling
.acs_write_probe
.write_test
